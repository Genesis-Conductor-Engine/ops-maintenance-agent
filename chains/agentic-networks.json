{
  "version": 1,
  "purpose": "Agentic arbitration + cashflow settlement mesh (R07 Soul.sol + multi-chain)",
  "north_star": "Support 13\u00d7$70k MRR via on-chain settlement, LP, and agent economies",
  "signers": {
    "preferred": "hardhat-ledger",
    "hot_key_env": [
      "ETH_PRIVATE_KEY",
      "BASE_PRIVATE_KEY"
    ],
    "ledger_env": "LEDGER_ACCOUNT",
    "note": "Hot keys only for rotation sweeps; production arbitration uses Ledger"
  },
  "tooling": {
    "rust": {
      "crate": "/root/agentic-arbitration",
      "deps": [
        "alloy"
      ],
      "role": "multi-chain RPC, receipts, balance, event decode for arbitration"
    },
    "hardhat": {
      "project": "/home/diamondnode/Yennefer",
      "plugins": [
        "@nomicfoundation/hardhat-toolbox",
        "@nomicfoundation/hardhat-ledger"
      ],
      "role": "deploy, verify, ledger-signed txs"
    },
    "foundry": {
      "projects": [
        "/home/diamondnode/Yennefer/aerodrome-lp",
        "/home/diamondnode/genesis-conductor-bundle/epoch"
      ],
      "role": "LP scripts, epoch contracts, forge tests"
    },
    "thirdweb": {
      "package": "thirdweb",
      "role": "SDK wallets, contract wrappers, engine for agent ops",
      "scaffold": "/root/ops-maintenance-agent/chains/thirdweb"
    },
    "cashflow": {
      "ledger": "/root/ops-maintenance-agent/scripts/cashflow-ledger.mjs",
      "redis_key": "diamondnode:cashflow:v1",
      "stream_primary": "R07"
    },
    "shopify": {
      "module": "/root/ops-maintenance-agent/shopify-agentic",
      "role": "x402 facilitator + Admin order attribution + Payments Apps session resolve + Partner reconcile",
      "preview_store": {
        "name": "Genesis Agentic Commerce",
        "domain": "51wnq0-ip.myshopify.com",
        "id": "83057541348"
      },
      "attribution": {
        "path_a": "Admin orderCreate with customAttributes (tx_hash, chain_id, agent_id, stream_id)",
        "path_b": "Payments Apps paymentSessionResolve(networkTransactionId=tx_hash)",
        "idempotency": "chainId:txHash"
      },
      "cli": {
        "dry_run": "node /root/ops-maintenance-agent/shopify-agentic/src/cli.mjs dry-run",
        "challenge": "node /root/ops-maintenance-agent/shopify-agentic/src/cli.mjs challenge"
      }
    },
    "suivision": {
      "default_explorer": "https://suivision.xyz",
      "module_node": "/root/ops-maintenance-agent/chains/suivision.mjs",
      "module_browser": "/home/diamondnode/yennefer-quest-deploy/public/js/suivision.js",
      "role": "Default Sui explorer redirects for DApps (account, txblock, coin, nft, object)",
      "paths": {
        "account": "/account/{accountaddress}",
        "txblock": "/txblock/{txndigest}",
        "coin": "/coin/{cointype}",
        "nft_collection": "/nft/collection/{collectiontype}",
        "nft_object": "/nft/object/{objectid}",
        "object": "/object/{objectid}"
      }
    }
  },
